POSTGRES_USER=aquamine
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aquamine_db
DATABASE_URL=postgresql+psycopg://aquamine:changeme@db:5432/aquamine_db
REDIS_URL=redis://redis:6379/0
# For VPS deployment, replace localhost with your VPS IP or domain:
# NEXT_PUBLIC_API_BASE_URL=http://YOUR_VPS_IP/api
# NEXT_PUBLIC_API_BASE_URL=http://your-domain.com/api
# NEXT_PUBLIC_WS_BASE_URL=ws://YOUR_VPS_IP (HTTP) or wss://your-domain.com (HTTPS)
#
# CRITICAL: These variables must be set in .env BEFORE running docker compose build
# Next.js bakes these values into the JavaScript bundle at build time
NEXT_PUBLIC_API_BASE_URL=http://localhost:8181
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8181

# Frontend API URL (used by dashboard)
NEXT_PUBLIC_API_URL=http://localhost:8181

# Site URL for metadata and SEO (used by Next.js)
# - Local dev: http://localhost:3000
# - Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend CORS (comma-separated origins). Must match dashboard's public URL.
CORS_ORIGINS=http://localhost:3000

# Backend runtime environment.
# - development: default local/dev behavior
# - production: enables production-only protections (e.g. TrustedHostMiddleware)
# - test: enables test-only endpoints like DELETE /api/v1/test-data
ENVIRONMENT=development

# IoT Sensor Ingestion API Key (used by ESP32/MQTT to authenticate HTTP POST)
INGEST_API_KEY=your-secret-ingest-key-here

# MQTT Configuration (for IoT sensor data ingestion)
MQTT_BROKER=your-mqtt-broker.hivemq.cloud
MQTT_PORT=8883
MQTT_TOPIC_PREFIX=itb/surya/water/data
MQTT_CLIENT_ID=aquamine_backend_listener
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_TLS_INSECURE=true

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# LLM Configuration
# Cerebras (for analytics - fast)
CEREBRAS_API_KEY=your-cerebras-api-key-here
# OpenRouter (for chatbot - configurable model)
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Model format: provider/model-name (e.g., openai/gpt-4o-mini, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Chatbot Token Budgeting
AI_CHAT_CONTEXT_WINDOW_TOKENS=32768
AI_CHAT_COMPACTION_THRESHOLD=0.85
AI_CHAT_RESERVED_OUTPUT_TOKENS=2048

# Required for backend JWT verification (e.g. https://<your-domain>.clerk.accounts.dev)
CLERK_ISSUER=
# Optional: Override JWKS URL if not using default issuer/.well-known/jwks.json
# CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/access-pending
SUPERADMIN_EMAIL=
