# Auto detect text files and handle line endings
* text=auto

# Force LF line endings for shell scripts
*.sh text eol=lf

# Force LF for Python files
*.py text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker-compose.yaml text eol=lf

# JSON and YAML
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.bash text eol=lf
*.zsh text eol=lf
